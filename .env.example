# === LLM Provider (only for runAgent; SDK read examples need no AI key) ===
AI_PROVIDER=anthropic                # anthropic | openai
ANTHROPIC_API_KEY=                   # Your Anthropic API key
OPENAI_API_KEY=                      # Your OpenAI API key

# === Optional public account for demo:account ===
WALLET_ADDRESS=                      # Public address; no wallet generation needed
# Separate local signing utilities only, never required by MCP reads:
PRIVATE_KEY=                         # Never share with an agent or server

# === Separate local signer mode (not used by native-current MCP) ===
SIGNER_MODE=simple                   # simple | secure; manual daemon approval recommended

# === Native-current MCP (read-only, chain 16661) ===
# Source-contract endpoint pending release; override for a running local backend.
ZEROG_MCP_URL=https://0g.exploreme.pro/api/v1/mcp
# No transaction preparation, signing, broadcasting or faucet in this service.
